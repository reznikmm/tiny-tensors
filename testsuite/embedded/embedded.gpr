with "config/embedded_config.gpr";
project Embedded is
   for Runtime ("Ada") use "light-tasking-stm32f4";
   for Target use "arm-eabi";

   for Source_Dirs use ("src/", "../src", "config/");
   for Object_Dir use "obj/" & Embedded_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("embedded.adb");

   package Compiler is
      for Default_Switches ("Ada") use Embedded_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,--gc-sections",
         "-Wl,-Map=map.txt",
         "-Wl,--defsym=__stack_size=0x2000");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Ide is
      for Program_Host use "localhost:4242";
      for Communication_Protocol use "remote";
      for Connection_Tool use "st-util";  --  "openocd";
      --  for Connection_Config_Files use
      --    ("interface/stlink.cfg", "target/stm32f4x.cfg");
   end Ide;
end Embedded;
